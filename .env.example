# Neon Postgres ulanish satri (https://console.neon.tech dan olinadi)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# `openssl rand -base64 32` bilan yangi maxfiy kalit yarating
BETTER_AUTH_SECRET="..."
BETTER_AUTH_URL="http://localhost:9999"

# Admin panelga kirish paroli
ADMIN_PASSWORD="..."

# Internetga chiqarganda: saytning domeni (vergul bilan bir nechta bo'lishi mumkin)
# TRUSTED_ORIGINS="https://sizning-domeningiz.com"

# IELTS Speaking: ovozni matnga aylantirish (OpenAI Whisper)
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# IELTS Speaking: javobni IELTS mezonlari bo'yicha baholash (Claude)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
